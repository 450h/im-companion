# =========================================================================
# .env.example: MED 222 IM Companion has NO secrets and NO API keys.
# The app's only network use is the anonymous "newer version?" GitHub Releases check.
# These optional variables exist only for development and tests.
# Legend: [DEV] honoured only in unpackaged builds (!app.isPackaged)
# These are SHELL environment variables: the app does not read a .env file.
#   PowerShell:  $env:IMC_DATA_DIR = ".dev-data"; npm run dev
#   Git Bash:    IMC_DATA_DIR=.dev-data npm run dev
# =========================================================================

# Keep dev/test data away from your real progress folder (%APPDATA%\MED 222 IM Companion).
IMC_DATA_DIR=.dev-data            # [DEV] folder for progress.json and backups/

# Disable the release check in dev runs.
IMC_DISABLE_UPDATES=1             # [DEV]

# Build-time content tooling: where the source PDFs live on the owner's PC (never committed).
IMC_SOURCE_DIR=C:\Users\<you>\OneDrive\Desktop\Med_source   # [BUILD] read by scripts/extract only

# CI only — provided automatically by GitHub Actions, never stored in a file:
# GH_TOKEN=                       # [CI SECRET] github.token, used to publish releases
# Code signing (only if OPEN-QUESTIONS D2 is ever decided):
# CSC_LINK=                       # [CI SECRET] base64 .pfx certificate
# CSC_KEY_PASSWORD=               # [CI SECRET]
