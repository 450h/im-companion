{
  "name": "im-companion",
  "productName": "MED 222 IM Companion",
  "version": "0.5.0",
  "description": "Free Windows study app for Internal Medicine (Med 611): blueprint-driven planner, cited summaries, flashcards and EMQ/MCQ practice.",
  "main": "./out/main/index.js",
  "author": "450h",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/450h/im-companion",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:lint": "vitest run src/main/content.test.ts",
    "guard:copyright": "node scripts/copyright-guard.mjs",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --win --publish never",
    "content:tools": "node scripts/content-tools.mjs",
    "make-icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tesseract.js": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
